# Claude Code project-local skills — kept local, NOT tracked here per the
# T12 publishing decision. The pi-skill-creator and karpathy-guidelines
# under .claude/skills/ are workstation-local artifacts.
.claude/

# Reference material — not hexxu-authored content
inspiration/

# Upstream pi source (own .git, anyone can re-clone independently)
pisource/

# Eval working state (generated, large, regenerable)
skill-workspaces/

# Pre-existing pi-fork history, archived for reference, never tracked
.git.pi-fork-archive/

# Pi extension local node_modules (each extension manages its own)
.pi/extensions/*/node_modules/

# Pi runtime state we don't want to publish
.pi/hf-sessions/
.pi/hf-sessions-backup/
.pi_config/

# Hexxu local cache and telemetry (worker-machine state, not source)
.hexxu/

# Misc generated files (left over from the pi-fork era)
